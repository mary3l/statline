# Copy to .env and fill in. .env is git-ignored; never commit real values.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Postgres connection string. Leave empty to use the embedded PGlite database in PGLITE_DIR (local dev only).
# DATABASE_URL=postgres://statline:password@localhost:5432/statline
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# Player photos and birth certificates (private files; back them up with the database).
UPLOAD_DIR=./.data/uploads

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Session cookie needs HTTPS when true. Defaults to true in production.
# COOKIE_SECURE=false

# First admin account, created by `npm run db:seed` (or `npm run db:accounts`).
SEED_ADMIN_EMAIL=admin@statline.test
SEED_ADMIN_PASSWORD=

# Development only: shared password for the test accounts organizer@statline.test and scorer@statline.test.
# Leave empty to skip them. They are never created when NODE_ENV=production.
SEED_DEMO_PASSWORD=
