{
  "name": "statline-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STATLINE API: leagues, players, box scores, standings and leaders (Fastify + Postgres)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --import tsx src/dev.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "tsx src/seed/index.ts --reset",
    "db:accounts": "tsx src/seed/run-accounts.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "11.0.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "4.1.11"
  }
}
